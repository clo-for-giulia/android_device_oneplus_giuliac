<?xml version="1.0" encoding="UTF-8"?>
<displayConfiguration>
    <densityMapping>
        <density>
            <height>2376</height>
            <width>1080</width>
            <density>450</density>
        </density>
        <density>
            <height>2780</height>
            <width>1264</width>
            <density>520</density>
        </density>
    </densityMapping>

    <!-- Global Brightness-Nit mapping -->
    <screenBrightnessMap>
        <point>
            <value>0.000250</value> <!-- BL: 1 (Min) -->
            <nits>2.0</nits>
        </point>
        <point>
            <value>0.050013</value> <!-- BL: 200 -->
            <nits>20.0</nits>
        </point>
        <point>
            <value>0.150038</value> <!-- BL: 600 -->
            <nits>70.0</nits>
        </point>
        <point>
            <value>0.300075</value> <!-- BL: 1200 -->
            <nits>150.0</nits>
        </point>
        <point>
            <value>0.409602</value> <!-- BL: 1638 (Default Boot) -->
            <nits>200.0</nits>
        </point>
        <point>
            <value>0.490123</value> <!-- BL: 1960 (2160Hz PWM / DC Dimming Boundary) -->
            <nits>250.0</nits>
        </point>
        <point>
            <value>0.650163</value> <!-- BL: 2600 -->
            <nits>380.0</nits>
        </point>
        <point>
            <value>0.809702</value> <!-- BL: 3238 (Manual SDR Max) -->
            <nits>540.0</nits>
        </point>
        <point>
            <value>0.900225</value> <!-- BL: 3600 (HBM Transition) -->
            <nits>800.0</nits>
        </point>
        <point>
            <value>1.0</value>       <!-- BL: 3999 (HBM Max) -->
            <nits>1100.0</nits>
        </point>
    </screenBrightnessMap>

    <highBrightnessMode enabled="true">
        <transitionPoint>0.809702</transitionPoint>

        <minimumLux>5882</minimumLux>
        <timing>
        <!-- Window in which we restrict HBM. -->
        <timeWindowSecs>1800</timeWindowSecs>
        <!-- Maximum time of HBM allowed in that window -->
        <timeMaxSecs>300</timeMaxSecs>
        <!-- Minimum time remaining required to switch HBM on for -->
        <timeMinSecs>60</timeMinSecs>
        </timing>
        <sdrHdrRatioMap>
            <point>
                <sdrNits>2.0</sdrNits>
                <hdrRatio>8.0</hdrRatio>
            </point>
            <point>
                <sdrNits>540.0</sdrNits> 
                <hdrRatio>3.98</hdrRatio>
            </point>
        </sdrHdrRatioMap>
    </highBrightnessMode>

    <idleScreenRefreshRateTimeout>
        <luxThresholds>
            <point>
                <lux>0</lux>
                <timeout>500</timeout>
            </point>
        </luxThresholds>
    </idleScreenRefreshRateTimeout>
    <supportsVrr>true</supportsVrr>
</displayConfiguration>
